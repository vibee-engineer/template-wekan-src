# Dockerfile.preview — the founding.dev DEV image for this template.
#
# WHAT THIS IS FOR
# When someone imports this template we boot a dev server they can edit with AI
# and see change immediately. Building WeKan from source on that machine, on the
# critical path, costs tens of minutes. This image does that work ahead of time
# in CI so the import is a pull instead of a build.
#
# WHY IT CANNOT REUSE THE PRODUCTION Dockerfile
# The production Dockerfile does not build the working tree at all — it fetches
# a prebuilt WeKan release .zip and unpacks it. That is correct for shipping a
# pinned release and useless for us: a customer's edits would never appear,
# because the source they edited is not what runs. This image runs `meteor run`
# against the mounted tree, which is the only way an edit reaches the page.
#
# THE BIND-MOUNT RULE (the one that bites)
# docker-compose.preview.yml bind-mounts the repo over /app, and a bind mount
# shadows EVERY path the image build wrote underneath it. Each warm directory
# baked here must be re-exposed as a named volume in that compose file or it
# vanishes at runtime. For this template that is:
#
#   /app/node_modules      npm deps
#   /app/.meteor/local     Meteor's compiled bundle cache — the expensive one
#
# Miss either and the container spends the boot rebuilding what this image
# already contains, which defeats the whole point.
FROM node:24-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    METEOR_ALLOW_SUPERUSER=true \
    NODE_OPTIONS=--max-old-space-size=4096 \
    # Meteor phones home on every command; nothing here needs it and it adds
    # seconds to a cold container.
    METEOR_DISABLE_ANALYTICS=1

# Meteor's own build toolchain needs a compiler for native npm modules
# (bcrypt, fibers-era leftovers). git is required by Meteor's package resolver.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      build-essential python3 git curl ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Meteor is installed as a BOOTSTRAPPER, not pinned to a version here. The
# release this project needs lives in .meteor/release, and the launcher fetches
# exactly that on first use — so this layer stays valid across release bumps and
# the version has one source of truth in the repo rather than two.
# Bootstrapper AND pinned release in ONE layer, with the caches dropped inside
# it. Split across two RUNs, the installer's tarballs are frozen into the first
# layer and deleting them later frees nothing — a layer can only add. This is
# worth ~2 GB on an image that gets pulled onto every dev machine.
COPY .meteor/release .meteor/release
COPY .meteor/versions .meteor/versions
COPY .meteor/packages .meteor/packages
COPY .meteor/platforms .meteor/platforms
RUN curl -fsSL https://install.meteor.com/ | sh \
 && meteor --version \
 # /root/.npm and /tmp are safe to drop. /root/.meteor/package-metadata is NOT:
 # it is Meteor's package index, and Meteor installs some per-package npm deps
 # at RUNTIME on first boot ("updating npm dependencies ..."). Without the index
 # it cannot resolve them, so instead of self-healing it dies claiming it cannot
 # find rspack.config.js — a message that points at the wrong file entirely. The
 # real symptom is @meteorjs/rspack missing from node_modules.
 && rm -rf /root/.npm /tmp/* 2>/dev/null || true

# npm deps next, on their own layer for the same reason.
# scripts/ comes along because package.json has a postinstall hook
# (`node scripts/patch-yargs-dirname.cjs`) that runs as part of the install. With
# only package.json copied, npm install dies at the very end with a bare
# "command failed" and no mention of the missing file. It is 8 KB, so it costs
# this layer nothing and keeps the dependency cache separate from the source.
COPY package.json package-lock.json* ./
COPY scripts ./scripts
RUN meteor npm install --no-audit --no-fund && rm -rf /root/.npm

# Now the source, and the warm compile. `meteor build` populates .meteor/local
# with the compiled bundle cache that makes the FIRST `meteor run` fast instead
# of a full cold compile. The build output itself is thrown away — we want the
# cache it leaves behind, not the artifact.
COPY . .
# NO --exclude-archs here: that flag exists on `meteor run`, NOT on `meteor
# build`, which answers an unknown flag by printing its usage line and exiting 0.
#
# And this step is NOT allowed to fail softly any more. It used to end in
# `|| echo "warm build failed ... still usable"`, which is how an image shipped
# with .meteor/local at 4 KB instead of 258 MB — the entire warm cache missing,
# no error anywhere, and the first boot dying on a half-built project. A warm
# cache is the whole reason this image exists; if it cannot be built, the build
# must fail here rather than hand someone a broken preview.
RUN meteor build --directory /tmp/wekan-warm --server-only --allow-superuser \
 && du -sh /app/.meteor/local \
 && rm -rf /tmp/wekan-warm /root/.npm 2>/dev/null || true

# WRITABLE_PATH is required by server/00checkStartup.js, which exits the process
# when it is unset or unwritable. Created here so the image is runnable on its
# own; the compose file mounts a named volume over it so uploads persist.
ENV WRITABLE_PATH=/data
# ── Prune the package store to the versions this project actually pins ───────
# /root/.meteor is 3.7 GB of a 7.08 GB image, and /root/.meteor/packages is 3.3 GB
# of that — with meteor-tool alone at 1.5 GB and six compiler packages sitting at
# a suspiciously uniform ~250 MB each. That shape is the store keeping EVERY
# version it ever resolved, not the ones this project runs.
#
# The pull is the whole gap between this template and the design target: the app
# itself serves in ~30s once the image is local, and the reference point is a
# 1.25 GB image pulling in 52s. Nothing else on the critical path is worth
# optimising until this number comes down.
#
# SAFE BY CONSTRUCTION. The keep-list is read from the project's own lockfiles —
# .meteor/versions for packages, .meteor/release for the tool — so this can only
# ever delete a version that is not pinned. If the duplicate-versions theory is
# wrong, it deletes nothing and the size is unchanged; it cannot remove something
# the build needs.
#
# WHAT IT MUST NOT TOUCH: /root/.meteor/package-metadata. Deleting that during an
# earlier slimming attempt broke Meteor's ability to resolve npm dependencies at
# RUNTIME on first boot, and the symptom was a confusing "cannot find
# rspack.config.js" rather than anything naming the index. Only <name>/<version>
# directories under packages/ are candidates here.
RUN set -eu; \
    store=/root/.meteor/packages; \
    before=$(du -sm "$store" | cut -f1); \
    keep=/tmp/keep.txt; : > "$keep"; \
    # .meteor/versions is "package@version" per line.
    sed -n 's/^\([a-zA-Z0-9_:-]*\)@\(.*\)$/\1 \2/p' /app/.meteor/versions >> "$keep"; \
    # .meteor/release is "METEOR@x.y.z"; the store dir is packages/meteor-tool.
    rel=$(sed -n 's/^METEOR@//p' /app/.meteor/release | tr -d '[:space:]'); \
    [ -n "$rel" ] && echo "meteor-tool $rel" >> "$keep"; \
    # Meteor writes ':' in package names as '_' on disk (e.g. meteortesting_mocha).
    sed -i 's/:/_/' "$keep"; \
    for pkgdir in "$store"/*; do \
      [ -d "$pkgdir" ] || continue; \
      name=$(basename "$pkgdir"); \
      wanted=$(awk -v n="$name" '$1==n{print $2}' "$keep"); \
      # A package with no entry in the keep-list is left ALONE, not deleted:
      # absence means "this lockfile does not describe it", which is not the
      # same as "it is unused" (the tool pulls its own deps).
      [ -n "$wanted" ] || continue; \
      for verdir in "$pkgdir"/*; do \
        [ -d "$verdir" ] || continue; \
        v=$(basename "$verdir"); \
        echo "$wanted" | tr ' ' '\n' | grep -qx "$v" || rm -rf "$verdir"; \
      done; \
    done; \
    rm -f "$keep"; \
    after=$(du -sm "$store" | cut -f1); \
    echo "[slim] package store ${before}MB -> ${after}MB (freed $((before-after))MB)"; \
    # Prove the toolchain still resolves after the prune. Failing HERE is cheap;
    # failing on a customer's first boot is not.
    cd /app && meteor --version

RUN mkdir -p /data

EXPOSE 8080

# ONE-ELEMENT LIST, deliberately. A bare string under a list-form entrypoint gets
# shell-split by compose, and everything after the first && is silently dropped —
# a failure mode that looks like the command simply never ran.
#
# --port 0.0.0.0:8080 because binding loopback inside a container is unreachable
# through the port map, and the platform's HOSTNAME/HOST env coaxing does not
# reach a Meteor CLI flag.
# Bare --port, not 0.0.0.0:8080: with the host:port form Meteor 3.5's Rspack dev
# server derives its HMR port as NaN and exits with ERR_SOCKET_BAD_PORT before
# finishing its first compilation. A bare port already binds all interfaces
# inside a container.
CMD ["sh", "-c", "meteor run --port 8080 --allow-superuser --exclude-archs web.browser.legacy,web.cordova"]
